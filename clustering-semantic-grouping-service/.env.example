# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Kafka Configuration
KAFKA_BROKERS=154.53.166.231:9092
SCHEMA_REGISTRY_URL=http://154.53.166.231:8081
KAFKA_INPUT_TOPIC=embeddings
KAFKA_OUTPUT_TOPIC=semantic_groups
KAFKA_CONSUMER_GROUP=clustering-service-group
MAX_POLL_INTERVAL_MS=300000
PROCESSING_TIMEOUT_SECONDS=30

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION_NAME=news_embeddings_v1
QDRANT_VECTOR_SIZE=768
QDRANT_TIMEOUT=30

# PostgreSQL Configuration
POSTGRES_HOST=154.53.166.231
POSTGRES_PORT=5432
POSTGRES_USER=adminsentiment
POSTGRES_PASSWORD=wp2400!!!!
POSTGRES_DB=sentiment
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_TTL_SECONDS=86400
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5

# Clustering Configuration
CLUSTERING_ALGORITHM=hdbscan
MIN_CLUSTER_SIZE=3
MIN_SAMPLES=2
CLUSTER_SELECTION_EPSILON=0.15
CLUSTERING_METRIC=cosine
SIMILARITY_THRESHOLD=0.85
MAX_CLUSTER_SIZE=1000
TIME_WINDOW_HOURS=24
OVERLAP_HOURS=6
EXECUTION_FREQUENCY_HOURS=4

# Validation Configuration
MIN_CLUSTER_PURITY=0.85
MAX_TIME_SPAN_HOURS=168
MIN_SOURCES=2
LANGUAGE_CONSISTENCY_THRESHOLD=0.70
DOMAIN_CONSISTENCY_THRESHOLD=0.60

# Service Configuration
API_HOST=0.0.0.0
API_PORT=8082
PROMETHEUS_PORT=9104
ENABLE_TRACING=true
JAEGER_HOST=localhost
JAEGER_PORT=6831

