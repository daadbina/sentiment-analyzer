# Crawler Service Configuration

# Crawling Configuration
CRAWL_INTERVAL_MINUTES=30
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT_SECONDS=10
RETRY_BACKOFF_SECONDS=30
MAX_RETRIES=5

# Language Detection Configuration
LANG_CONF_THRESHOLD=0.8

# Schema Configuration
SCHEMA_VERSION=v1.0

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=news_raw
KAFKA_ACKS=all
KAFKA_MAX_RETRIES=5
KAFKA_DLQ_TOPIC=news_raw_dlq

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=http://localhost:8081

# Database Configuration (PostgreSQL/TimescaleDB)
POSTGRES_HOST=154.53.166.231
POSTGRES_PORT=5432
POSTGRES_USER=adminsentiment
POSTGRES_PASSWORD=wp2400!!!!
POSTGRES_DB=sentiment
DB_MIN_POOL_SIZE=5
DB_MAX_POOL_SIZE=20

# Monitoring Configuration
PROMETHEUS_PORT=9101
PROMETHEUS_HOST=0.0.0.0

# Jaeger Tracing Configuration
JAEGER_ENABLED=false
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Application Configuration
APP_NAME=crawler-service
APP_VERSION=1.0.0
ENVIRONMENT=development

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_TIMEOUT_MINUTES=10

# Deduplication Configuration
DEDUP_CACHE_SIZE=10000

