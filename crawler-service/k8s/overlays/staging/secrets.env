# Staging Secrets - DO NOT COMMIT
# Use Vault or sealed-secrets in production

# Kafka Configuration
KAFKA_BROKERS=kafka-staging:9092
KAFKA_SASL_USERNAME=crawler-staging
KAFKA_SASL_PASSWORD=CHANGE_ME
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# Schema Registry Configuration
SCHEMA_REGISTRY_URL=http://schema-registry-staging:8081
SCHEMA_REGISTRY_USERNAME=crawler-staging
SCHEMA_REGISTRY_PASSWORD=CHANGE_ME

# Database Configuration
POSTGRES_USER=adminsentiment
POSTGRES_PASSWORD=wp2400!!!!

# Redis Configuration
REDIS_URL=redis://:CHANGE_ME@redis-staging:6379/0

# Jaeger Configuration
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=jaeger-staging
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.5

# Monitoring Configuration
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9101

# Application Configuration
APP_NAME=crawler-service
APP_VERSION=1.0.0
ENVIRONMENT=staging

