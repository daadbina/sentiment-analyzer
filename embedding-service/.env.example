# Embedding Service Configuration Example
# Copy this file to .env and update values for your environment

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_INPUT_TOPIC=news_canonical
KAFKA_OUTPUT_TOPIC=embeddings
KAFKA_CONSUMER_GROUP=embedding-service
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_PROCESSING_TIMEOUT_SECONDS=30

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=embeddings
QDRANT_VECTOR_SIZE=768

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=embedding
POSTGRES_PASSWORD=embedding
POSTGRES_DB=embedding
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5
REDIS_CACHE_TTL_SECONDS=86400

# Model Configuration
MODEL_CACHE_DIR=./models
MODEL_DEFAULT_MODEL=all-mpnet-base-v2
MODEL_DEVICE=cuda
MODEL_BATCH_SIZE_GPU=32
MODEL_BATCH_SIZE_CPU=16
MODEL_MAX_SEQUENCE_LENGTH=512
MODEL_GPU_MEMORY_FRACTION=0.8
MODEL_POOL_SIZE=5

# Validation Configuration
VALIDATION_ENABLED=true
VALIDATION_DRIFT_DETECTION_ENABLED=true
VALIDATION_DRIFT_SAMPLE_SIZE=1000
VALIDATION_DRIFT_THRESHOLD=0.05

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30

# Metrics Configuration
METRICS_PROMETHEUS_PORT=8001
METRICS_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

