# ============================================================================
# Sentiment Analyzer v2 - Docker Environment Configuration
# ============================================================================
# This file contains all environment variables for running the system in Docker
# Copy this to .env and adjust values as needed
# ============================================================================

# ============================================================================
# GLOBAL SETTINGS
# ============================================================================
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_FORMAT=json
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# ============================================================================
# INFRASTRUCTURE SERVICES (Docker Containers)
# ============================================================================

# Kafka Configuration (Local Docker)
KAFKA_BROKERS=kafka:29092
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
SCHEMA_REGISTRY_URL=http://schema-registry:8081
KAFKA_SCHEMA_REGISTRY_URL=http://schema-registry:8081

# Kafka Topics
KAFKA_TOPIC_NEWS_RAW=news_raw
KAFKA_TOPIC_NEWS_VALIDATED=news_validated
KAFKA_TOPIC_NEWS_CANONICAL=news_canonical
KAFKA_TOPIC_ENTITIES_EXTRACTED=entities_extracted
KAFKA_TOPIC_EMBEDDINGS=embeddings
KAFKA_TOPIC_SEMANTIC_GROUPS=semantic_groups
KAFKA_TOPIC_FEATURES_COMPUTED=features_computed
KAFKA_TOPIC_LABELED_GROUPS=labeled_groups
KAFKA_TOPIC_MODELS_TRAINED=models_trained
KAFKA_TOPIC_GROUND_TRUTH=ground_truth
KAFKA_TOPIC_PREDICTIONS=predictions

# Kafka Settings
KAFKA_ACKS=all
KAFKA_MAX_RETRIES=5
KAFKA_MAX_POLL_INTERVAL_MS=300000
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=3000
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_ENABLE_AUTO_COMMIT=false
KAFKA_MAX_POLL_RECORDS=100

# PostgreSQL Configuration (Local Docker)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=adminsentiment
POSTGRES_PASSWORD=wp2400!!!!
POSTGRES_DB=sentiment_analyzer
POSTGRES_DATABASE=sentiment_analyzer
POSTGRES_MIN_POOL_SIZE=5
POSTGRES_MAX_POOL_SIZE=20
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10
POSTGRES_POOL_TIMEOUT=30

# MinIO/S3 Configuration (Local Docker)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET_NAME=sentiment-analyzer
S3_REGION=us-east-1

# ============================================================================
# LOCAL SERVICES (Docker Containers)
# ============================================================================

# Redis Configuration (Local Docker)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5
REDIS_CACHE_TTL_SECONDS=86400
REDIS_POOL_SIZE=50

# Qdrant Configuration (Local Docker)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=news_embeddings_v1
QDRANT_VECTOR_SIZE=768
QDRANT_TIMEOUT=30

# Neo4j Configuration (Local Docker)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=sentiment_password_2024
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT=30
NEO4J_MAX_TRANSACTION_RETRY_TIME=30
NEO4J_POOL_SIZE=50

# MLflow Configuration (Local Docker)
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_MODEL_NAME=predictor_model
MLFLOW_MODEL_VERSION=v1.0.0
MLFLOW_MODEL_STAGE=Production
MLFLOW_FALLBACK_MODEL_VERSION=v0.9.0
MLFLOW_BACKEND_STORE_URI=postgresql://mlflow:mlflow_password_2024@mlflow-postgres:5432/mlflow
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# Prometheus Configuration (Local Docker)
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_METRICS_ENABLED=true

# Jaeger Configuration (Local Docker)
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=jaeger
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1
ENABLE_TRACING=true

# ============================================================================
# SERVICE-SPECIFIC CONFIGURATIONS
# ============================================================================

# Crawler Service
CRAWL_INTERVAL_MINUTES=30
MAX_CONCURRENT_REQUESTS=50
REQUEST_TIMEOUT_SECONDS=10
RETRY_BACKOFF_SECONDS=30
MAX_RETRIES=5
LANG_CONF_THRESHOLD=0.8
SCHEMA_VERSION=v1.0

# Ingest Validator Service
VALIDATION_ENABLED=true
VALIDATION_DRIFT_DETECTION_ENABLED=true
VALIDATION_DRIFT_SAMPLE_SIZE=1000
VALIDATION_DRIFT_THRESHOLD=0.05

# Canonicalizer Normalizer Service
NORMALIZATION_SCORE_ACCEPT=0.85
NORMALIZATION_SCORE_REVIEW=0.70
FUZZY_DEDUP_THRESHOLD=0.90

# Embedding Service
MODEL_CACHE_DIR=/models
MODEL_DEFAULT_MODEL=all-mpnet-base-v2
MODEL_DEVICE=cpu
MODEL_BATCH_SIZE_GPU=32
MODEL_BATCH_SIZE_CPU=16
MODEL_MAX_SEQUENCE_LENGTH=512
MODEL_GPU_MEMORY_FRACTION=0.8
MODEL_POOL_SIZE=5

# Clustering Service
CLUSTERING_ALGORITHM=hdbscan
MIN_CLUSTER_SIZE=3
MIN_SAMPLES=2
CLUSTER_SELECTION_EPSILON=0.15
CLUSTERING_METRIC=cosine
SIMILARITY_THRESHOLD=0.85
MAX_CLUSTER_SIZE=1000
TIME_WINDOW_HOURS=24
OVERLAP_HOURS=6
EXECUTION_FREQUENCY_HOURS=4
MIN_CLUSTER_PURITY=0.85
MAX_TIME_SPAN_HOURS=168
MIN_SOURCES=2
LANGUAGE_CONSISTENCY_THRESHOLD=0.70
DOMAIN_CONSISTENCY_THRESHOLD=0.60

# Feature Engineering Service
FEAST_REPO_PATH=/feast
FEAST_ONLINE_STORE_TYPE=redis
FEAST_ONLINE_STORE_HOST=redis
FEAST_ONLINE_STORE_PORT=6379
FEAST_OFFLINE_STORE_TYPE=delta
FEAST_OFFLINE_STORE_PATH=/data/delta_lake

# Labeler Ground Truth Service
ACLED_API_URL=https://acleddata.com/api
ACLED_OAUTH_URL=https://acleddata.com/oauth/token
ACLED_USERNAME=your_acled_email@example.com
ACLED_PASSWORD=your_acled_password
ACLED_API_KEY=
ACLED_FETCH_INTERVAL_HOURS=24
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
GDELT_FETCH_INTERVAL_HOURS=1
BINANCE_API_URL=https://api.binance.com/api/v3
BINANCE_FETCH_INTERVAL_MINUTES=5
LABEL_RECONCILIATION_THRESHOLD_HOURS=48
LABEL_CONFIDENCE_THRESHOLD=0.7
LABEL_TEMPORAL_THRESHOLD_HOURS=24
LABEL_FRESHNESS_ACLED_HOURS=24
LABEL_FRESHNESS_GDELT_HOURS=1
LABEL_FRESHNESS_BINANCE_MINUTES=5

# Trainer Service
TRAINING_ENABLED=true
TRAINING_SCHEDULE_CRON=0 2 * * *
TRAINING_MIN_SAMPLES=1000
TRAINING_TEST_SIZE=0.2
TRAINING_VALIDATION_SIZE=0.1

# Predictor Service
PREDICTION_BATCH_SIZE=100
PREDICTION_TIMEOUT_SECONDS=30
VALIDATION_FEATURE_FRESHNESS_THRESHOLD_SECONDS=3600
VALIDATION_FEATURE_RECONCILIATION_THRESHOLD=0.99
VALIDATION_LABEL_CONSISTENCY_THRESHOLD=0.85

# API Analytics Service
JWT_SECRET_KEY=your-secret-key-change-in-production-RANDOM-STRING-HERE
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=10000
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_SECONDS=60
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_TITLE=Sentiment Analyzer API
API_VERSION=1.0.0

# ============================================================================
# STORAGE PATHS
# ============================================================================
DELTA_LAKE_PATH=/data/delta_lake
DELTA_LAKE_BACKUP_PATH=/data/delta_lake/backup

# ============================================================================
# CIRCUIT BREAKER & RESILIENCE
# ============================================================================
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT_SECONDS=30
PROCESSING_TIMEOUT_SECONDS=30

# ============================================================================
# CONSUMER GROUPS (Kafka)
# ============================================================================
CONSUMER_GROUP_CRAWLER=crawler-service-group
CONSUMER_GROUP_INGEST_VALIDATOR=ingest-validator-service-group
CONSUMER_GROUP_CANONICALIZER=canonicalizer-service-group
CONSUMER_GROUP_NER=ner-entity-linking-service-group
CONSUMER_GROUP_EMBEDDING=embedding-service-group
CONSUMER_GROUP_CLUSTERING=clustering-service-group
CONSUMER_GROUP_FEATURE_ENGINEERING=feature-engineering-service-group
CONSUMER_GROUP_LABELER=labeler-ground-truth-ingest-service-group
CONSUMER_GROUP_TRAINER=trainer-model-registry-service-group
CONSUMER_GROUP_NEO4J_LOADER=neo4j-loader-graph-service-group
CONSUMER_GROUP_PREDICTOR=predictor-online-inference-service-group

# ============================================================================
# MONITORING PORTS (Prometheus Exporters)
# ============================================================================
PROMETHEUS_PORT_CRAWLER=9101
PROMETHEUS_PORT_INGEST_VALIDATOR=9102
PROMETHEUS_PORT_CANONICALIZER=9103
PROMETHEUS_PORT_NER=9104
PROMETHEUS_PORT_EMBEDDING=9105
PROMETHEUS_PORT_CLUSTERING=9106
PROMETHEUS_PORT_FEATURE_ENGINEERING=9107
PROMETHEUS_PORT_LABELER=9108
PROMETHEUS_PORT_TRAINER=9109
PROMETHEUS_PORT_NEO4J_LOADER=9110
PROMETHEUS_PORT_PREDICTOR=9111
PROMETHEUS_PORT_API=9112

