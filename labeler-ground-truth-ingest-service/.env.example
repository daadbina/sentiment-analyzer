# Kafka Configuration
KAFKA_BROKERS=154.53.166.231:9092
KAFKA_CONSUMER_GROUP=labeler-ground-truth-ingest-service
KAFKA_SCHEMA_REGISTRY_URL=http://154.53.166.231:8081
KAFKA_GROUND_TRUTH_TOPIC=ground_truth
KAFKA_SEMANTIC_GROUPS_TOPIC=semantic_groups

# PostgreSQL Configuration
POSTGRES_HOST=154.53.166.231
POSTGRES_PORT=5432
POSTGRES_USER=adminsentiment
POSTGRES_PASSWORD=wp2400!!!!
POSTGRES_DATABASE=sentiment
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# ACLED API Configuration (OAuth 2.0)
ACLED_API_URL=https://acleddata.com/api
ACLED_OAUTH_URL=https://acleddata.com/oauth/token
ACLED_USERNAME=your_acled_email@example.com
ACLED_PASSWORD=your_acled_password
ACLED_API_KEY=
ACLED_FETCH_INTERVAL_HOURS=24
ACLED_BACKUP_API_URL=https://acleddata.com/api

# GDELT API Configuration
GDELT_API_URL=https://api.gdeltproject.org
GDELT_FETCH_INTERVAL_HOURS=1
GDELT_BACKUP_API_URL=https://api.gdeltproject.org/backup

# Binance API Configuration (Free Alternative to CoinGecko)
BINANCE_API_URL=https://api.binance.com/api/v3
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT
BINANCE_INTERVAL=1h
BINANCE_LIMIT=1000
BINANCE_FETCH_INTERVAL_MINUTES=5
BINANCE_BACKUP_API_URL=https://api.binance.com/api/v3

# CCXT API Configuration (Fallback for crypto data from multiple exchanges)
CCXT_ENABLED=true
CCXT_EXCHANGES=kraken,coinbase,bybit
CCXT_SYMBOLS=BTC/USD,ETH/USD,BNB/USD
CCXT_TIMEFRAME=1h
CCXT_LIMIT=1000
CCXT_FETCH_INTERVAL_MINUTES=5

# Label Configuration
LABEL_RECONCILIATION_THRESHOLD_HOURS=48
LABEL_CONFIDENCE_THRESHOLD=0.7
LABEL_TEMPORAL_THRESHOLD_HOURS=24
LABEL_FRESHNESS_ACLED_HOURS=24
LABEL_FRESHNESS_GDELT_HOURS=1
LABEL_FRESHNESS_BINANCE_MINUTES=5

# Storage Configuration
DELTA_LAKE_PATH=/data/delta_lake/ground_truth
DELTA_LAKE_BACKUP_PATH=/data/delta_lake/backup

# Metrics Configuration
PROMETHEUS_PORT=9107
PROMETHEUS_METRICS_ENABLED=true

# Tracing Configuration
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Service Configuration
SERVICE_NAME=labeler-ground-truth-ingest-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# API Client Configuration
API_CLIENT_TIMEOUT_SECONDS=30
API_CLIENT_RETRY_MAX_ATTEMPTS=3
API_CLIENT_RETRY_BACKOFF_FACTOR=2
API_CLIENT_CIRCUIT_BREAKER_THRESHOLD=5
API_CLIENT_CIRCUIT_BREAKER_TIMEOUT_SECONDS=60

# Reconciliation Configuration
RECONCILIATION_BATCH_SIZE=100
RECONCILIATION_TIMEOUT_SECONDS=300
RECONCILIATION_CONFIDENCE_THRESHOLD=0.75

# Validation Configuration
VALIDATION_BATCH_SIZE=100
VALIDATION_TIMEOUT_SECONDS=300
VALIDATION_ENABLE_LICENSE_CHECK=true
VALIDATION_ENABLE_FRESHNESS_CHECK=true

# Deduplication Configuration
DEDUPLICATION_ENABLED=true
DEDUPLICATION_HASH_ALGORITHM=sha256
DEDUPLICATION_SIMILARITY_THRESHOLD=0.95

# Drift Detection Configuration
DRIFT_DETECTION_ENABLED=true
DRIFT_DETECTION_WINDOW_SIZE=100
DRIFT_DETECTION_THRESHOLD=0.15

