{
  "type": "record",
  "name": "ReconciliationCompletedMessage",
  "namespace": "com.sentiment_analyzer.labeler",
  "doc": "Event published when a semantic group has been reconciled with GDELT ground truth labels",
  "fields": [
    {
      "name": "group_id",
      "type": "string",
      "doc": "Unique identifier for the semantic group that was reconciled"
    },
    {
      "name": "reconciled_at",
      "type": "string",
      "doc": "Timestamp when reconciliation completed (ISO-8601, UTC)"
    },
    {
      "name": "label_count",
      "type": "int",
      "doc": "Number of GDELT labels matched to this group"
    },
    {
      "name": "has_conflict",
      "type": ["null", "boolean"],
      "default": null,
      "doc": "True if any matched GDELT event is a conflict (label_conflict=1), False if all are non-conflict (label_conflict=0), null if no GDELT metadata available"
    },
    {
      "name": "conflict_event_count",
      "type": "int",
      "default": 0,
      "doc": "Number of conflict events (label_conflict=1) matched to this group"
    },
    {
      "name": "non_conflict_event_count",
      "type": "int",
      "default": 0,
      "doc": "Number of non-conflict events (label_conflict=0) matched to this group"
    },
    {
      "name": "countries",
      "type": {
        "type": "array",
        "items": "string"
      },
      "default": [],
      "doc": "List of countries involved in the reconciled events"
    },
    {
      "name": "batch_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Batch identifier for this reconciliation job"
    },
    {
      "name": "trace_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "Distributed tracing identifier"
    },
    {
      "name": "schema_version",
      "type": "string",
      "default": "1.0.0",
      "doc": "Schema version for compatibility tracking"
    }
  ]
}

