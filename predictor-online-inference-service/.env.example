# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081
KAFKA_CONSUMER_GROUP_ID=predictor-service
KAFKA_INPUT_TOPIC=semantic_groups
KAFKA_OUTPUT_TOPIC=predictions
KAFKA_GROUND_TRUTH_TOPIC=ground_truth

# MLflow Configuration
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_AUTO_SELECT_BEST_MODEL=false
MLFLOW_MODEL_SELECTION_METRIC=f1
MLFLOW_BTC_MODEL_NAME=btc_prediction_xgboost_regressor_base
MLFLOW_CONFLICT_MODEL_NAME=conflict_prediction_gradient_boosting_base
MLFLOW_MODEL_VERSION=1
MLFLOW_MODEL_STAGE=
MLFLOW_FALLBACK_MODEL_VERSION=
MLFLOW_MODEL_LOAD_TIMEOUT_SECONDS=30

# Feast Configuration
FEAST_REPO_PATH=/feast
FEAST_ONLINE_STORE_TYPE=redis
FEAST_ONLINE_STORE_HOST=localhost
FEAST_ONLINE_STORE_PORT=6379
FEAST_OFFLINE_STORE_TYPE=delta
FEAST_OFFLINE_STORE_PATH=s3://feast-offline-store

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50
REDIS_SOCKET_TIMEOUT=5

# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=sentiment_analyzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_MIN_POOL_SIZE=10
POSTGRES_MAX_POOL_SIZE=50
POSTGRES_PREDICTIONS_TABLE=predictions
POSTGRES_GROUND_TRUTH_TABLE=ground_truth

# Inference Configuration
INFERENCE_BATCH_SIZE=100
INFERENCE_TIMEOUT_SECONDS=30
INFERENCE_CACHE_TTL_SECONDS=3600
INFERENCE_ENABLE_STREAMING=true
INFERENCE_AB_TESTING_ENABLED=false
INFERENCE_AB_TESTING_VARIANT_A=v1.0.0
INFERENCE_AB_TESTING_VARIANT_B=v1.1.0
INFERENCE_AB_TESTING_TRAFFIC_SPLIT=0.5

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Monitoring Configuration
MONITORING_PROMETHEUS_PORT=9090
MONITORING_JAEGER_HOST=localhost
MONITORING_JAEGER_PORT=6831
MONITORING_LOG_LEVEL=INFO

# Validation Configuration
VALIDATION_FEATURE_FRESHNESS_THRESHOLD_SECONDS=3600
VALIDATION_FEATURE_RECONCILIATION_THRESHOLD=0.99
VALIDATION_LABEL_CONSISTENCY_THRESHOLD=0.85

