# ============================================================================
# TRAINER & MODEL REGISTRY SERVICE - ENVIRONMENT CONFIGURATION
# ============================================================================

# ============================================================================
# FEAST CONFIGURATION
# ============================================================================
FEAST_REGISTRY_PATH=/feast/registry.db
FEAST_FEATURE_STORE_TYPE=local

# ============================================================================
# MLFLOW CONFIGURATION
# ============================================================================
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_STORE=s3://sentiment-analyzer/mlflow
MLFLOW_REGISTRY_URI=http://localhost:5000

# ============================================================================
# S3 CONFIGURATION
# ============================================================================
S3_BUCKET=sentiment-analyzer-models
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000

# ============================================================================
# POSTGRESQL CONFIGURATION
# ============================================================================
POSTGRES_HOST=154.53.166.231
POSTGRES_PORT=5432
POSTGRES_USER=adminsentiment
POSTGRES_PASSWORD=wp2400!!!!
POSTGRES_DATABASE=sentiment
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20
POSTGRES_POOL_TIMEOUT=30
POSTGRES_POOL_RECYCLE=3600

# ============================================================================
# KAFKA CONFIGURATION
# ============================================================================
KAFKA_BOOTSTRAP_SERVERS=154.53.166.231:9092
KAFKA_SCHEMA_REGISTRY_URL=http://154.53.166.231:8081
KAFKA_CONSUMER_GROUP=trainer-service
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ============================================================================
# TRAINING CONFIGURATION
# ============================================================================
TRAINING_WINDOW_MONTHS=18
TEST_SET_SIZE=0.2
VALIDATION_SET_SIZE=0.1
RANDOM_SEED=42

# ============================================================================
# XGBOOST CONFIGURATION
# ============================================================================
XGBOOST_MAX_DEPTH=6
XGBOOST_LEARNING_RATE=0.1
XGBOOST_N_ESTIMATORS=100
XGBOOST_SUBSAMPLE=0.8
XGBOOST_COLSAMPLE_BYTREE=0.8
XGBOOST_EARLY_STOPPING_ROUNDS=10
XGBOOST_EVAL_METRIC=auc

# ============================================================================
# LOGISTIC REGRESSION CONFIGURATION
# ============================================================================
LOGISTIC_REGRESSION_C=1.0
LOGISTIC_REGRESSION_PENALTY=l2
LOGISTIC_REGRESSION_SOLVER=lbfgs
LOGISTIC_REGRESSION_MAX_ITER=1000

# ============================================================================
# HYPERPARAMETER TUNING CONFIGURATION
# ============================================================================
HYPERPARAMETER_TUNING_ENABLED=true
HYPERPARAMETER_TUNING_TRIALS=50
HYPERPARAMETER_TUNING_TIMEOUT=3600
HYPERPARAMETER_TUNING_N_JOBS=4

# ============================================================================
# DRIFT DETECTION CONFIGURATION
# ============================================================================
DRIFT_DETECTION_ENABLED=true
DRIFT_DETECTION_THRESHOLD=0.1
DRIFT_DETECTION_REFERENCE_WINDOW=30

# ============================================================================
# MODEL PROMOTION CONFIGURATION
# ============================================================================
MODEL_PROMOTION_THRESHOLD_AUC=0.75
MODEL_PROMOTION_THRESHOLD_PRECISION=0.70
MODEL_PROMOTION_THRESHOLD_F1=0.70

# ============================================================================
# PROMETHEUS CONFIGURATION
# ============================================================================
PROMETHEUS_PORT=9108
PROMETHEUS_ENABLED=true

# ============================================================================
# JAEGER CONFIGURATION
# ============================================================================
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=const
JAEGER_SAMPLER_PARAM=1

# ============================================================================
# SERVICE CONFIGURATION
# ============================================================================
SERVICE_NAME=trainer-model-registry-service
SERVICE_VERSION=1.0.0
SERVICE_PORT=8000
SERVICE_HOST=0.0.0.0
LOG_LEVEL=INFO
DEBUG=false

# ============================================================================
# LLM CONFIGURATION
# ============================================================================
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_MODEL=gpt-4
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

